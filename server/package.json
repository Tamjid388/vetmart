{
	"type": "module",
	"packageManager": "pnpm@10.30.3",
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"bcryptjs": "^3.0.3",
		"compression": "^1.8.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.7.0",
		"helmet": "^8.3.0",
		"http-status-codes": "^2.3.0",
		"jsonwebtoken": "^9.0.3",
		"morgan": "^1.12.0",
		"pg": "^8.23.0",
		"zod": "^4.6.1"
	},
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc",
		"start": "node dist/server.js",
		"lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/*.ts\"",
		"test": "vitest run",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:seed": "tsx prisma/seed.ts",
		"db:studio": "prisma studio",
		"prepare": "husky",
		"postinstall": "prisma generate || exit 0"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"lint-staged": {
		"*.ts": [
			"eslint --fix",
			"prettier --write"
		]
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/compression": "^1.8.1",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"@types/node": "^26.2.0",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"prettier": "^3.9.6",
		"prisma": "7.10.0",
		"supertest": "^7.2.2",
		"tsx": "^4.23.12",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "^5.0.0"
	}
}
